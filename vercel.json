{
  "framework": null,
  "installCommand": "",
  "buildCommand": "",
  "outputDirectory": "backend/app/static",
  "cleanUrls": false,
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://YOUR-BACKEND.onrender.com/api/:path*" },
    { "source": "/docs", "destination": "https://YOUR-BACKEND.onrender.com/docs" },
    { "source": "/openapi.json", "destination": "https://YOUR-BACKEND.onrender.com/openapi.json" }
  ],
  "headers": [
    { "source": "/(.*)", "headers": [
      { "key": "X-Content-Type-Options", "value": "nosniff" },
      { "key": "X-Frame-Options", "value": "DENY" },
      { "key": "Referrer-Policy", "value": "no-referrer" }
    ] }
  ]
}
